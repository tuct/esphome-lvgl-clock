# Copy to secrets.yaml (gitignored) before compiling any of the example_*.yaml
# configs - common_base.yaml pulls these in with !secret.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
wifi_ap_password: "fallback-hotspot-password"
api_key: "base64-encoded-32-byte-key"
ota_password: "your-ota-password"
